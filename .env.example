# Variables de entorno para la aplicación de lectura de manga

# URL base de la API de MangaDex (no requiere clave de API para endpoints públicos)
NEXT_PUBLIC_MANGADEX_API_URL=https://api.mangadex.org

# URL del entorno de desarrollo de MangaDex (opcional, para pruebas)
# NEXT_PUBLIC_MANGADEX_DEV_URL=https://api.mangadex.dev

# Nota: Esta aplicación no requiere autenticación ni claves privadas en el frontend.
# Todas las credenciales sensibles deben mantenerse en el backend, nunca expuestas al cliente.
